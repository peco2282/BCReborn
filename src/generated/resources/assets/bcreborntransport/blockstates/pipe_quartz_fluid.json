      }
    },
    {
      "apply": {
        "model": "bcreborntransport:block/pipe/quartz_fluid_south"
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "bcreborntransport:block/pipe/quartz_fluid_west"
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
